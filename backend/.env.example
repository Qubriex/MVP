# Qubirex backend — environment template. Copy to .env and fill in values.

# Google Gemini API key (https://aistudio.google.com/app/apikey) — powers all six brains
GEMINI_API_KEY=

# Secret used to sign JWTs for institution / learner / admin sessions
JWT_SECRET=

# SQLite database file path
DB_PATH=./qubirex.db

# Backend port
PORT=3001

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# Path to the python3 binary used to grade Python mastery checks in a
# subprocess sandbox (see core/sandbox/pythonSandbox.js). Defaults to
# "python3" on PATH — set explicitly if your deployment target needs it.
PYTHON_BIN=python3

# Optional — Gemini per-1,000-token pricing in USD, used only to estimate
# cost in GET /admin/cost-report. Left unset (0) by default: an unconfigured
# report reads as an honest "$0 — not configured", never a guessed number.
GEMINI_INPUT_PRICE_PER_1K_USD=
GEMINI_OUTPUT_PRICE_PER_1K_USD=
